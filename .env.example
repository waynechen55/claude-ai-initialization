###############################################################################
# initialize-claude-ai :: example environment file
#
#   cp .env.example .env      # then edit; .env is never read automatically
#   initialize-claude-ai run --env-file .env
#
# Everything below is optional: initialize-claude-ai runs with no environment at all and
# falls back to the packaged defaults in initialize_claude_ai/data/*.toml.
#
# THIS FILE MUST NOT CONTAIN A CREDENTIAL.
# Credentials are named by *reference*, never by value. A reference says where
# to read a secret at run time; the value never enters a config file, a log
# line, an agent prompt or the JSON report. Supported schemes:
#
#   env:NAME                read environment variable NAME
#   file:/path/to/secret    read a file (warns if group/world readable)
#   keyring:service/user    read the OS keyring (needs the 'keyring' extra)
#   command:some --cmd      run a command and take its stdout
#   gcloud-adc              gcloud auth application-default print-access-token
#   gcloud-token            gcloud auth print-access-token
#   prompt:Label            ask interactively, with echo off
#   literal:VALUE           inline value -- for testing only, never commit one
#
# The one place a real secret legitimately lives is your shell/secret manager,
# exported as the variable an env: reference points at.
#
# Run with --secure to forbid literal: outright -- in this file, in the
# environment, in --set and on the command line. Every credential must then be
# named rather than handed over.
###############################################################################

# --------------------------------------------------------------------------- #
# Any setting can be overridden here: INITIALIZE_CLAUDE_AI_<SECTION>__<KEY>, where '__'
# separates nesting levels and the value is TOML-ish (true/false/numbers/CSV).
#   provision.vertex.region  ->  INITIALIZE_CLAUDE_AI_PROVISION__VERTEX__REGION
# --------------------------------------------------------------------------- #
# INITIALIZE_CLAUDE_AI_RUN__DEFAULT_PHASES=1,2,3,4
# INITIALIZE_CLAUDE_AI_HTTP__TIMEOUT_SECONDS=15
# INITIALIZE_CLAUDE_AI_MCP__REGISTER_SCOPE=user
# How long any one command may take, and how a command that outruns that is
# ended: these signals in order, each given the grace period to work.
# INITIALIZE_CLAUDE_AI_RUN__COMMAND_TIMEOUT_SECONDS=600
# INITIALIZE_CLAUDE_AI_RUN__STOP_SIGNALS=TERM,KILL
# INITIALIZE_CLAUDE_AI_RUN__STOP_GRACE_SECONDS=5
# A wall-clock ceiling for the whole run, in seconds; 0 (the default) means
# none. The --timeout flag is the same thing and also takes 45s / 90m / 2h / 1d.
# Not a per-operation timeout: those already exist and are unchanged. It stops
# the run *starting* new work -- an address already being worked is left to
# finish -- so the run can overrun by as long as one address takes.
# INITIALIZE_CLAUDE_AI_TIMEOUT=0
# Multiply every per-operation timeout; 1.0 (the default) leaves them as written.
# Useful with --concurrency, where several addresses contend for one CPU and
# link. Scoring thresholds and the SIGTERM-to-SIGKILL grace are not timeouts and
# are not affected.
# INITIALIZE_CLAUDE_AI_TIMEOUT_SCALE=1.0

# --------------------------------------------------------------------------- #
# General
# --------------------------------------------------------------------------- #
# trace | debug | info | warning | error -- what appears on screen.
# INITIALIZE_CLAUDE_AI_LOG_LEVEL=info
# State, logs, generated bridges and the recorded binary paths live here.
# INITIALIZE_CLAUDE_AI_STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/initialize-claude-ai

# Every run records itself here: the banners and summary boxes exactly as they
# appeared, the JSON report, and the log records interleaved between them, with
# colour stripped and credentials redacted. --quiet and --json change the
# terminal, not this file. Empty means 'record nothing' (same as --no-log-file).
# The default is relative, so the log lands in whatever directory you ran the
# command from; set an absolute path here to collect every run in one place.
# INITIALIZE_CLAUDE_AI_LOG_FILE=claude_ai_initialization.log
# Level kept in the file, independent of the screen. 'trace' is the noisiest.
# INITIALIZE_CLAUDE_AI_LOG_FILE_LEVEL=debug
# false records only the log records, leaving an ordinary log rather than a
# transcript of what was on screen.
# INITIALIZE_CLAUDE_AI_LOG_RECORD_OUTPUT=true
# Show each log level on screen as the badge the report uses -- a WARNING on
# stderr then looks like a [PARTIAL] step on stdout, which matters because the
# two arrive interleaved in one scrollback. The file always keeps the plain
# format; false gives the terminal the plain form too.
# INITIALIZE_CLAUDE_AI_LOG_BADGES=true
# Put the date and time in front of every line that records something, on
# screen and in the log file, in the same format the log records use. Box
# frames, table rows, blank lines and the --json report are never stamped:
# a box is one event rather than a line each, and its alignment depends on
# its width. false gives the older, unstamped narration.
# INITIALIZE_CLAUDE_AI_CONSOLE_TIMESTAMPS=true
# Rotation, checked when the file is opened. 0 for either never rotates.
# INITIALIZE_CLAUDE_AI_LOG_MAX_BYTES=5000000
# INITIALIZE_CLAUDE_AI_LOG_BACKUPS=3
# Claude Code's own configuration directory (settings.json, .credentials.json).
# CLAUDE_CONFIG_DIR=$HOME/.claude
# Extra skills for the phase-4 agents, on top of the packaged ones.
# INITIALIZE_CLAUDE_AI_SKILLS_DIR=

# --------------------------------------------------------------------------- #
# Phase 1 -- install
# Only needed when the defaults cannot reach the usual sources.
# --------------------------------------------------------------------------- #
# INITIALIZE_CLAUDE_AI_CLAUDE_DESKTOP_URL=
# INITIALIZE_CLAUDE_AI_CLAUDE_DESKTOP_FLATPAK_REF=
# The --install-only / --install-skip selections, made permanent (CSV of
# component keys or group names).
# INITIALIZE_CLAUDE_AI_INSTALL__ONLY=
# INITIALIZE_CLAUDE_AI_INSTALL__SKIP=
# The --force-install / --break-dependencies / --downgrade flags, made permanent.
# INITIALIZE_CLAUDE_AI_INSTALL__FORCE=false
# INITIALIZE_CLAUDE_AI_INSTALL__ALLOW_BREAK_SYSTEM_PACKAGES=false
# INITIALIZE_CLAUDE_AI_INSTALL__DOWNGRADE=false
# auto | system | venv | user. 'auto' installs into the system interpreter
# unless it is externally managed under PEP 668 -- openSUSE, Debian, Fedora,
# Arch and Homebrew all are -- and then builds a virtualenv instead, which is
# the only target that does not need --break-dependencies on those hosts.
# INITIALIZE_CLAUDE_AI_INSTALL__PYTHON_TARGET=auto
# Where that virtualenv goes. Default: $INITIALIZE_CLAUDE_AI_STATE_DIR/venv
# INITIALIZE_CLAUDE_AI_INSTALL__VENV_PATH=
# Which interpreter the Python-module checks import with. The detected one is
# used normally; set this on a machine where the interpreter that should own the
# SDKs is not the one on PATH.
# INITIALIZE_CLAUDE_AI_INSTALL_PYTHON=python3
# --install-prefetch, made permanent: none | launchers | all. 'launchers' also
# installs the programs phase 4 launches MCP servers with (the first word of
# every command in install.demand_sources -- npx, uvx, ...); 'all' adds every
# mcp-runtimes toolchain (go, rust, deno, bun, docker). Always optional, and
# --install-only wins over it.
# INITIALIZE_CLAUDE_AI_INSTALL_PREFETCH=launchers
# The Go release the go.dev download fallback fetches when no package manager
# has Go, and the minimum version each mcp-runtimes toolchain must report.
# Empty minimums accept any version that runs.
# INITIALIZE_CLAUDE_AI_GO_VERSION=1.25.1
# INITIALIZE_CLAUDE_AI_GO_MIN_VERSION=
# INITIALIZE_CLAUDE_AI_RUST_MIN_VERSION=
# INITIALIZE_CLAUDE_AI_DENO_MIN_VERSION=
# INITIALIZE_CLAUDE_AI_BUN_MIN_VERSION=
# INITIALIZE_CLAUDE_AI_DOCKER_MIN_VERSION=

# --------------------------------------------------------------------------- #
# Phase 2 -- authentication
# --------------------------------------------------------------------------- #
# Which backends to attempt, or "all". --auth-backend
# INITIALIZE_CLAUDE_AI_AUTH__BACKENDS=google-cloud,claude-oauth,anthropic-api
# Sign in again even where detection found a working credential. --force-auth
# INITIALIZE_CLAUDE_AI_AUTH__FORCE=false
# Clear the existing credentials before signing in again -- revoke the gcloud
# login and its application-default credential, log the claude CLI out, empty
# this program's own browser profile. --force-auth-with-reset, which sets FORCE
# too. Separate from FORCE because it is destructive and host-wide: a revoked
# gcloud credential is gone for every tool on this machine. Reach for it when
# --force-auth did not ask you for anything -- the provider was re-using a
# session it still held.
# INITIALIZE_CLAUDE_AI_AUTH__RESET=false
# Move credential files aside as <name>.<timestamp>.bak rather than deleting
# them. Off by default: a backup of a credential is still a credential, and a
# readable copy beside the file you just asked to have cleared defeats the ask.
# INITIALIZE_CLAUDE_AI_AUTH__RESET_BACKUP=false
# Also empty the browser profile this program uses for sign-ins (never your own
# one). The provider's cookie lives there, and it is what lets a "fresh" login
# finish without a password.
# INITIALIZE_CLAUDE_AI_AUTH__RESET_BROWSER_PROFILE=true
# Which interactive sign-in flow EVERY backend uses -- one answer for the run.
#   auto      every sign-in ends with a code pasted back; where a browser can
#             be shown the URL is opened in it for you (see OPEN_URL below).
#   headless  paste a code, open nothing: you carry the URL yourself. --headless.
#   browser   the loopback redirect, for a browser known to reach this machine:
#             no code, but nothing to fall back on if it does not come back.
#             --browser-loopback-redirect.
# INITIALIZE_CLAUDE_AI_AUTH_BROWSER_MODE=auto
# What "a display" means to `auto` (and to everything else that asks: the
# clipboard, the browser choice) is detected from DISPLAY / WAYLAND_DISPLAY,
# macOS and WSL. These settle it by hand when detection is wrong; FORCE_HEADLESS
# wins if both are set. Accepted: 1, true, yes, on.
# INITIALIZE_CLAUDE_AI_FORCE_HEADLESS=1
# INITIALIZE_CLAUDE_AI_FORCE_DISPLAY=1
# How long an interactive sign-in may block before the run gives up, in seconds.
# Expiring mid-flow kills gcloud while the browser still says "success", so this
# is deliberately generous. 0 waits for as long as it takes.
# INITIALIZE_CLAUDE_AI_AUTH__INTERACTIVE_TIMEOUT_SECONDS=1800

# The browser a sign-in opens. Separate from the mode above, and applied
# whichever mode is in force: the mode chooses the flow, these decide whether
# the browser at the end of it is usable. Even a pasted-code flow usually ends
# with the URL going into a browser on this same machine.
#
# What opens a URL, %s standing for it. --browser. Your own BROWSER is adopted
# if you have one; otherwise the first known browser on PATH is used.
# INITIALIZE_CLAUDE_AI_AUTH_BROWSER=firefox %s
# Make typed text reach the page: auto / always / never. --browser-input-fix
#
# Set this to "always" if the sign-in form will not take your email address --
# the characters appear, you click elsewhere, and "Enter your email or phone"
# floats back down over them. That is a host with an X display and no desktop
# session behind it: GTK_IM_MODULE and XMODIFIERS are unset, GTK falls back to
# an XIM bridge with no XIM server listening, and the page never receives an
# input event for anything you typed. "auto" detects exactly that case; "never"
# is correct on a desktop running ibus or fcitx, where overriding the input
# method would break composing non-Latin text.
# INITIALIZE_CLAUDE_AI_AUTH_BROWSER_IM_FIX=auto
# Sign in in a browser profile of this program's own: auto / always / never.
# --browser-profile. No extension hiding a form field, no second Google account
# already signed in. "auto" means where the default profile is unlikely to be
# usable anyway: no desktop session, or running as root.
# INITIALIZE_CLAUDE_AI_AUTH_BROWSER_PROFILE=auto

# Catch the sign-in URL as it is printed: auto / always / never.
# --sign-in-capture
#
# A pasted-code sign-in prints a URL of several hundred characters. gcloud sends
# it as one line and lets the terminal wrap it, which tmux, screen and a resized
# window will not give back whole; claude setup-token hard-wraps it before
# printing, so the newlines are really there and no terminal can. Capturing runs
# the sign-in on a pseudo-terminal, reads the URL off the stream (from the OSC 8
# hyperlink escape where the text was broken up), writes it to a 0600 file in the
# state directory and copies it to the clipboard. "auto" does this whenever stdin
# and stdout are both terminals; "never" hands the sign-in your terminal directly.
# INITIALIZE_CLAUDE_AI_AUTH_SIGNIN_PTY=auto
# Whether the sign-in URL is opened in a browser for you (you then paste back
# the code the page shows). auto: yes, unless --headless, which means you open
# it yourself. always: --headless too (needs a display). auto | always | never.
# INITIALIZE_CLAUDE_AI_AUTH_SIGNIN_OPEN_URL=auto
# After --force-auth-with-reset, the URL a pasted-code sign-in hands over (on
# screen, in the file, on the clipboard) goes through the provider's sign-out page first, so the browser you
# paste it into is signed out (every account in it) before the sign-in. It
# reaches only the provider's site: for single sign-on see IDP_SIGNOUT_URL
# below, or open the URL in a private window. reset | always | never.
# INITIALIZE_CLAUDE_AI_AUTH_SIGNIN_SIGN_OUT_FIRST=reset
# Your organisation's sign-out page, for an account that signs in through its
# own sign-in page (single sign-on): the provider's sign-out does not end that
# page's session. Made the first stop of the URL above; {continue} becomes the
# rest of it, URL-encoded. None by default -- a private window clears it too.
# INITIALIZE_CLAUDE_AI_AUTH_SIGNIN_IDP_SIGNOUT_URL=https://<your-sign-in-host>/<sign-out-path>?<param>={continue}
# What BROWSER the sign-in command sees in a pasted-code flow, so it cannot open
# the browser phase 2 exports for the redirect flow. The default accepts the URL
# and does nothing; empty removes BROWSER instead.
# INITIALIZE_CLAUDE_AI_AUTH_SIGNIN_PASTE_BROWSER=true

# Google Cloud
# The project phase 2 signs in against. --gcloud-project sets this and the Vertex
# project below together, so the run signs in against what it provisions. Set
# either way, every gcloud command phase 2 runs carries --project <id>, and
# gcloud's own active project is pointed at it for everything afterwards.
# GOOGLE_CLOUD_PROJECT=my-project
# CLOUDSDK_CORE_PROJECT=my-project
# Accounts are identities, not secrets: safe to write down. --gcloud-user-account
# INITIALIZE_CLAUDE_AI_GCP_ACCOUNT=me@example.com
# GOOGLE_CLOUD_USER_ACCOUNT=me@example.com
# Google's sign-out page, and the parameter it follows once the browser is
# signed out. Together they let a pasted-code sign-in after a reset sign the
# browser out first (see INITIALIZE_CLAUDE_AI_AUTH_SIGNIN_SIGN_OUT_FIRST). Empty
# turns that off.
# INITIALIZE_CLAUDE_AI_GCP_SIGNOUT_URL=https://accounts.google.com/Logout
# INITIALIZE_CLAUDE_AI_GCP_SIGNOUT_CONTINUE_PARAM=continue
# prompt values added to the sign-in behind that sign-out: select_account shows
# the account chooser rather than carrying on with an account Google remembers
# in that browser. Empty adds nothing.
# INITIALIZE_CLAUDE_AI_GCP_RESET_PROMPT=select_account
# Act as a service account without holding its key. --gcloud-service-account
# INITIALIZE_CLAUDE_AI_GCP_IMPERSONATE=vertex@my-project.iam.gserviceaccount.com
# Reference to a service-account key file -- a path, not a key. Keep it 0600.
# --gcloud-service-account-file takes the bare path and adds the file: itself.
# INITIALIZE_CLAUDE_AI_GCP_SA_KEY_REF=file:/etc/initialize-claude-ai/sa-key.json
# GOOGLE_CLOUD_QUOTA_PROJECT=

# claude.ai / Claude Code CLI
# The account this machine should be signed in as. --claude-user-account
# INITIALIZE_CLAUDE_AI_CLAUDE_ACCOUNT=me@example.com
# Sign-out page, and the parameter it follows afterwards; none by default.
# INITIALIZE_CLAUDE_AI_CLAUDE_SIGNOUT_URL=
# INITIALIZE_CLAUDE_AI_CLAUDE_SIGNOUT_CONTINUE_PARAM=
# INITIALIZE_CLAUDE_AI_CLAUDE_RESET_PROMPT=
# Where the long-lived token is read from. Default: env:CLAUDE_CODE_OAUTH_TOKEN.
# INITIALIZE_CLAUDE_AI_CLAUDE_TOKEN_REF=env:CLAUDE_CODE_OAUTH_TOKEN
# Mint a long-lived token with `claude setup-token` instead of storing a login
# (CI). Claude Code never stores that token: export CLAUDE_CODE_OAUTH_TOKEN
# wherever claude runs. Default false: `claude auth login`, a stored login.
# INITIALIZE_CLAUDE_AI_CLAUDE_LONG_LIVED_TOKEN=false
# The token itself belongs in your shell or secret manager, not in this file:
#   export CLAUDE_CODE_OAUTH_TOKEN="$(pass show claude/oauth)"
# Pasted-code sign-in (`claude setup-token` rather than `/login`, which mints a
# different kind of credential): initialize-claude-ai run --phases 2 --headless

# Direct Anthropic API. Again, export these elsewhere; listed for discoverability.
# Two different credentials in two different headers -- do not swap them:
#   ANTHROPIC_API_KEY    -> x-api-key             (the Console-issued key)
#   ANTHROPIC_AUTH_TOKEN -> Authorization: Bearer (a gateway or proxy token)
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --------------------------------------------------------------------------- #
# Phase 3 -- provision
# --------------------------------------------------------------------------- #
# vertex | anthropic-api | bedrock | auto. --provision-backend
# INITIALIZE_CLAUDE_AI_BACKEND=auto
# Whether Vertex may be provisioned against at all. --use-vertex. 0 takes it out
# of the 'auto' walk and refuses it if --provision-backend names it; it does not
# force Vertex to be chosen, which is --provision-backend vertex.
# INITIALIZE_CLAUDE_AI_USE_VERTEX=1
# CLAUDE_CODE_USE_VERTEX=1
# Vertex location. --gcloud-region. 'global' (the default), 'us' and 'europe' are
# multi-region locations served by aiplatform.googleapis.com; anything else uses
# <region>-aiplatform... The first of the two that is set wins.
# CLOUD_ML_REGION=us-east5
# GOOGLE_CLOUD_LOCATION=us-east5
# The project Vertex is billed to. --gcloud-project, which sets the phase 2
# project above to the same value. No default is invented: left unset, phase 3
# takes the project phase 2 signed in against, then gcloud's own, and stops the
# run outright if none of them has one.
# ANTHROPIC_VERTEX_PROJECT_ID=my-project
# Bedrock's region has no flag of its own -- it is a coordinate in another cloud.
# Provisioning Bedrock without one stops the run: every call names a region.
# AWS_REGION=us-east-1

# The tier Claude Code opens on: opus | sonnet | haiku. --default-model. This is
# written into settings.json "model" as the tier name itself, not as an id -- the
# id each tier resolved to is exported as ANTHROPIC_DEFAULT_<TIER>_MODEL below,
# and a tier name is the one spelling that stays right when the models move on or
# the backend changes. A model id here is written as the tier it belongs to.
# Empty means "whatever tier INITIALIZE_CLAUDE_AI_DEFAULT_TIER names". The second
# is the plain name for the same setting.
# INITIALIZE_CLAUDE_AI_MODEL=
# DEFAULT_MODEL=
# Which tier that is: opus | sonnet | haiku. 'sonnet' is the cheaper everyday one.
# INITIALIZE_CLAUDE_AI_DEFAULT_TIER=opus
# Per-backend overrides, used only when the backend is the active one.
# INITIALIZE_CLAUDE_AI_VERTEX_MODEL=
# INITIALIZE_CLAUDE_AI_API_MODEL=
# Per-tier pins written into settings.json. --default-opus-model and friends.
# Set one and that tier is taken at its word; leave it empty and the backend's
# live catalogue decides, which is the answer that knows what is actually served
# here and how this backend spells it (Vertex qualifies ids with @version).
# ANTHROPIC_DEFAULT_OPUS_MODEL=
# ANTHROPIC_DEFAULT_SONNET_MODEL=
# ANTHROPIC_DEFAULT_HAIKU_MODEL=
# Last resort, used only when there is no catalogue to ask -- offline, timed out,
# or an empty publisher list. A guess rather than a default; the run says so.
# INITIALIZE_CLAUDE_AI_FALLBACK_OPUS_MODEL=claude-opus-5
# INITIALIZE_CLAUDE_AI_FALLBACK_SONNET_MODEL=claude-sonnet-5
# INITIALIZE_CLAUDE_AI_FALLBACK_HAIKU_MODEL=claude-haiku-4-5

# The rest of settings.json. auto follows the terminal's own light/dark setting;
# fullscreen gives Claude Code the alternate screen buffer; the permission mode
# (default | acceptEdits | plan | bypassPermissions) decides what happens to a
# tool call no rule covers, and 'default' is the one that stops and asks. To
# leave one of these out of settings.json altogether, empty the setting rather
# than the variable -- INITIALIZE_CLAUDE_AI_PROVISION__SETTINGS__TUI= -- since an
# empty variable here means "unset" and falls back to the default shown.
# INITIALIZE_CLAUDE_AI_THEME=auto
# INITIALIZE_CLAUDE_AI_TUI=fullscreen
# INITIALIZE_CLAUDE_AI_PERMISSION_MODE=default
# Those three are seeded, not enforced: Claude Code writes settings.json too --
# /theme and /permissions put your own answer there -- so a value already in the
# file wins. Set this to make the configured values win instead, on every run.
# INITIALIZE_CLAUDE_AI_PROVISION__OVERWRITE_EXISTING_SETTINGS=false

# Claude Code exports the env block of settings.json into every process it
# launches, and phase 3 is what writes that block -- so a run started from
# inside Claude Code is handed back its own last answer dressed as the
# environment, where it would outrank this file and every configured default.
# That is a loop: the first region ever written goes on being written. So those
# variables are taken back out before anything is resolved, leaving the order
# you would expect -- command line, then this file, then the defaults, and the
# existing settings.json last (still a source: the Vertex project falls back to
# it, having no default worth inventing). Only an exact match is demoted, only
# the names in environment.echo_names, and never a credential
# (environment.echo_keep). Set this false to go back to treating the exported
# block as an ordinary environment.
# INITIALIZE_CLAUDE_AI_ENVIRONMENT__DEMOTE_ECHO=true

# Take the previous backend's variables back out of settings.json and the env
# files when you switch backend. A merge cannot delete, so with this off,
# provisioning anthropic-api over a machine that ran Vertex leaves
# CLAUDE_CODE_USE_VERTEX=1 behind and Claude Code keeps routing to Vertex. Only
# variables phase 3 can itself write are ever removed; your own are untouched.
# INITIALIZE_CLAUDE_AI_PROVISION__RETIRE_STALE_ENV=true

# --------------------------------------------------------------------------- #
# Phase 4 -- MCP discovery
# --------------------------------------------------------------------------- #
# Discovery starts agentic and falls back to deterministic probing per stage;
# the terminal tags what each stage did. Set this false (--no-agent) to run the
# deterministic pipeline alone: repeatable and free, but it will not reason its
# way to a server whose endpoint is not where convention would put it.
# INITIALIZE_CLAUDE_AI_MCP_AGENTIC=true
# Servers to discover against; --mcp-server wins over this. Comma separated, and
# each entry may be a full URL, a bare domain or host:port.
# INITIALIZE_CLAUDE_AI_MCP__SERVERS=https://mcp.example.com,api.example.com
# Confirm each address with one request (following redirects) before probing it.
# INITIALIZE_CLAUDE_AI_MCP__ADDRESS__RESOLVE=true
# Record every working endpoint per address (--exhaustive-mcp) instead of
# stopping at the first one. Every stage runs, every path is probed.
# INITIALIZE_CLAUDE_AI_MCP__EXHAUSTIVE=false
# Keep only the best server per address (--the-best-mcp) instead of registering
# every one that answers. Widens the search first, so the run takes longer.
# INITIALIZE_CLAUDE_AI_MCP__PICK_BEST=false
# Offer servers this machine already has registered (.mcp.json and `claude mcp
# list`) back as candidates for the address they point at, each verified at its
# own tier (--no-reuse-existing-mcp turns it off). A literal credential in one
# is never copied: it becomes a ${VAR} reference the operator exports.
# INITIALIZE_CLAUDE_AI_MCP_REUSE_EXISTING=true
# Remove this program's own leftovers at the end of a run (old temporary
# directories, unused work files); never a shared cache or anything an MCP
# entry names. --do-cleanup / --no-cleanup on the command line.
# INITIALIZE_CLAUDE_AI_DO_CLEANUP=true
# How long Claude Code waits for an MCP server to start, in milliseconds. Phase 4
# measures every written server's slowest start and, when one needs longer than
# Claude Code's default 30 s, sets MCP_TIMEOUT in Claude Code's settings.json env
# (and this program's environment file); set it here to choose the wait yourself.
# MCP_TIMEOUT=30000
# The public suffix list that tells an organisation (example.co.uk) from a
# registry suffix (co.uk), read when it exists; "" uses only the packaged
# mcp.grounding.multi_part_suffixes.
# INITIALIZE_CLAUDE_AI_PUBLIC_SUFFIX_FILE=/usr/share/publicsuffix/public_suffix_list.dat
# Whether a server's credential is checked with one read-only tool call when
# its value is exported (mcp.verification.login_check.mode): "pending" registers
# one whose credential was refused as waiting for a working one, "warn" only
# reports it, "off" calls nothing. A listing proves the server is there; only a
# call proves the service behind it accepts the credential.
# INITIALIZE_CLAUDE_AI_MCP_LOGIN_CHECK=pending
# Whether an endpoint that answered by demanding a credential ends the tier
# descent, the way a working one does. It should: a package is trialled without
# its secret, so "provisional" is the honest verdict for any target whose server
# wants a token, and while only "verified" counted, such a target was searched
# again at tier 2 and tier 3 -- minutes of agent time each, and a second
# .mcp.json entry competing with the first. false keeps searching anyway.
# INITIALIZE_CLAUDE_AI_MCP_PROVISIONAL_SETTLES_TARGET=true
# How many *other* hostnames one official-registry answer may send us to probe.
# A remotes[] entry is the vendor saying where their MCP endpoint lives, and it
# is often a sibling domain -- developers.google.com is served from
# developerknowledge.googleapis.com. Those used to be dropped before being
# probed, which lost a real server while step D still recorded it and the tier
# gate refused every lower tier because of it. 0 removes the cap; on-host
# remotes are never capped.
# INITIALIZE_CLAUDE_AI_MCP__DISCOVERY__REGISTRY_REMOTE_OTHER_HOSTS=3
# One turn budget for every phase-4 subagent, overriding each one's own
# (endpoint 10, package 10, bridge 12, strategy 10). 0 (the default) leaves them
# alone. --agent-max-turns is the same thing.
#
# Note that mcp.agent.max_turns (24) is only a fallback for an agent that sets
# none, and all four set one -- so raising *that* changes nothing. This is the
# key that does. Lowering it makes a long run genuinely cheaper (phase 4 is
# almost entirely agent thinking); raising it usually wants --timeout-scale too,
# because the stage timeout binds before the turn budget does.
# INITIALIZE_CLAUDE_AI_AGENT_MAX_TURNS=0
# Refuse an entry that carries no address, or one that is not the target's.
# `npx -y @kubb/mcp` was registered as the MCP server for confluence.example.com: a
# real MCP server, for something else, with nothing in the entry that could
# reach Confluence. A URL may be on a different host when that host answered as
# an MCP endpoint -- github.com is served from api.githubcopilot.com -- but a
# launcher must name the target's own host, because a launcher is never probed
# at an address and so nothing shows where it points.
# INITIALIZE_CLAUDE_AI_MCP_REQUIRE_ADDRESS=true
# One more directory under which a virtualenv is kept on purpose, so an entry
# naming an interpreter inside it is registered (host-bound) instead of refused
# as a trial venv. Phase 1's own venv, pipx's and `uv tool`'s are already
# durable, as is the venv this program runs from.
# INITIALIZE_CLAUDE_AI_MCP_DURABLE_VENV_ROOT=/opt/venvs
# Where a relocated bridge bundle lives. Entries name files this run generated
# as ${ICA_MCP_ARTIFACTS:-<the path they have on the machine that wrote them>},
# so nothing changes there; export this on another machine after copying the
# directory across and the same .mcp.json works unedited. Same idea for
# ICA_MCP_WORKSPACE, ICA_MCP_BRIDGES, ICA_WORK_DIR, ICA_STATE_DIR, and
# ICA_MCP_PYTHON for the interpreter a generated bridge is launched with.
# ICA_MCP_ARTIFACTS=
# ICA_MCP_PYTHON=
# Permit https://host with no path as an HTTP endpoint even though it never
# completed a handshake. It should not be: MCP endpoints live at a path, and a
# site's front door refusing an anonymous POST looks exactly like one.
# INITIALIZE_CLAUDE_AI_MCP__REGISTRATION__ALLOW_BARE_ORIGIN=false
# Variables that switch TLS certificate verification off. Never written into an
# entry -- .mcp.json is copied between machines, and the remedy for a private CA
# is the system trust store, not a flag riding along in the file.
# INITIALIZE_CLAUDE_AI_MCP__REGISTRATION__TLS_WEAKENING_ENV=NODE_TLS_REJECT_UNAUTHORIZED,PYTHONHTTPSVERIFY,GIT_SSL_NO_VERIFY,SSL_VERIFY,SSL_NO_VERIFY,CURL_INSECURE,REQUESTS_SKIP_VERIFY
# Phrases in a 401/403 body that mean "a human should log in here". Finding one
# overrules every other piece of protocol evidence: a login page served as
# application/json is still a login page. Extend it for a product whose wording
# is not covered.
# INITIALIZE_CLAUDE_AI_MCP__DISCOVERY__AUTH__LOGIN_PAGE_MARKERS=not logged in,login.action,please log in,please sign in,j_username,loginform,<form,<a href
# Where the discovered servers are written. Always written, and always also
# registered with the claude CLI. Relative means the directory you run in --
# which is where Claude Code looks for a project's MCP servers.
# INITIALIZE_CLAUDE_AI_MCP_JSON=.mcp.json
# Print the briefing -- what to export, what to install, which generated files
# not to delete -- in its own framed block at the end of phase 4, and keep it in
# the log. It is never written into .mcp.json: that file holds "mcpServers" and
# nothing else so it can be copied whole. Off still leaves it in --json output.
# INITIALIZE_CLAUDE_AI_MCP_BRIEFING=true
# Top-level keys removed from an existing .mcp.json, comma separated. Earlier
# versions wrote the briefing into the file under "_instructions"; this cleans
# that up. Only these names are touched -- any other key in the file is yours.
# INITIALIZE_CLAUDE_AI_MCP_STRIP_KEYS=_instructions
# Which interpreter a generated tier-3 bridge is registered with. Empty resolves
# it to an absolute path at generation time and writes that into .mcp.json --
# never the bare word "python3", which Claude Code would resolve again under its
# own PATH and may answer with a different Python whose certificate store does
# not carry your internal CA. Set this to pin a specific one.
# INITIALIZE_CLAUDE_AI_MCP_BRIDGE_PYTHON=/usr/bin/python3
# PEM bundle a generated bridge verifies TLS against. Empty auto-detects the
# system trust store (/etc/ssl/ca-bundle.pem and the other usual locations).
# Verification is never disabled: name the bundle that holds your internal CA.
# INITIALIZE_CLAUDE_AI_MCP_BRIDGE_CA_BUNDLE=/etc/ssl/ca-bundle.pem
# The trust store named to EVERY registered stdio server, not only a generated
# bridge. A target behind an internal CA is ordinary, and a runtime that ships
# its own certificate store -- Node's, certifi's -- cannot reach it: the server
# exits at start-up and Claude Code says only "Connection closed".
# build.example.net was exactly this, and the certificate was never mentioned
# anywhere in the diagnosis. Empty auto-detects the system bundle; the variable
# each runtime reads (NODE_EXTRA_CA_CERTS, SSL_CERT_FILE, ...) is written into
# the entry with that bundle as its default.
# INITIALIZE_CLAUDE_AI_MCP_TRUST_BUNDLE=/etc/ssl/ca-bundle.pem
# Extra certificate authorities (PEM files, comma-separated) trusted for this
# run, on top of the system store: every probe, every registered stdio server
# and every generated bridge gets them. Same as --mcp-trust-ca FILE[,FILE].
# Node.js only accepts a chain that ends at a self-signed root, so for Node
# servers name the root CA itself, not only an intermediate.
# INITIALIZE_CLAUDE_AI_MCP_TRUST_EXTRA_CA=/path/to/internal-root-ca.pem
# When a target's certificate is not trusted here, learn the chain it presents
# ("targets": only for addresses you asked for, only for the verify codes in
# mcp.trust.pin_verify_codes) or never ("never"). A learned chain is kept under
# the trust directory and announced in the report with its fingerprint, so it
# can be reviewed or deleted. Same as --mcp-trust-pin.
# INITIALIZE_CLAUDE_AI_MCP_TRUST_PIN_PRESENTED_CHAIN=targets
# Where learned chains and the run's combined bundle are kept.
# INITIALIZE_CLAUDE_AI_MCP_TRUST_DIR=~/.local/state/initialize-claude-ai/trust
# Require a request sent after the handshake to be answered, so an endpoint that
# can only say hello is not recorded as a working server.
# INITIALIZE_CLAUDE_AI_MCP__VERIFICATION__REQUIRE_ROUND_TRIP=true
# Accept a server that advertises no tools, resources or prompts at all.
# INITIALIZE_CLAUDE_AI_MCP__VERIFICATION__ALLOW_EMPTY_TOOLS=false
# What "best" means: each weight applies to one scored aspect. See [mcp.ranking]
# in initialize_claude_ai/data/40-mcp.toml for the full set and the penalties.
# INITIALIZE_CLAUDE_AI_MCP__RANKING__WEIGHTS__SECURITY=3.0
# Extra handshakes per candidate, so stability is measured rather than assumed.
# INITIALIZE_CLAUDE_AI_MCP__RANKING__STABILITY_PROBES=2
# Bearer token for probing an authenticated server -- a reference, not a token.
# Whatever this names also becomes the credential variable of any endpoint that
# answers 401/403, in preference to the derived name.
# INITIALIZE_CLAUDE_AI_MCP_TOKEN_REF=env:MY_MCP_TOKEN
#
# A 401 only counts as "an MCP endpoint wants a credential" when the rejection
# looked like a protocol answer. A Jira, a Confluence or any intranet answers
# 401/403 on every URL it owns, including ones that do not exist, so believing
# the status registers the website as a server -- an entry no token can fix.
# Any one signal is enough (an MCP header, a JSON-RPC body, a resource_metadata
# challenge, or simply a content type that is not a web page), so a real
# endpoint is never discarded. false restores the older behaviour.
# INITIALIZE_CLAUDE_AI_MCP__DISCOVERY__AUTH__REQUIRE_MCP_EVIDENCE=true
# Content types that are a web page, and so not evidence on their own.
# INITIALIZE_CLAUDE_AI_MCP__DISCOVERY__AUTH__DISQUALIFYING_CONTENT_TYPES=text/html,application/xhtml+xml
# Schemes worth copying out of a WWW-Authenticate challenge. Jira advertises
# `OAuth realm=...` -- OAuth 1.0a, which no single token satisfies -- so it is
# absent here and such an entry falls back to Bearer with a note.
# INITIALIZE_CLAUDE_AI_MCP__DISCOVERY__AUTH__HEADER_SCHEMES=Bearer,Basic,Token,ApiKey
# Before trusting a refusal, ask a path that cannot exist. If the invented path
# is refused identically, the refusal was the host's habit and says nothing
# about MCP. One request per origin, cached for the run -- and unlike a list of
# known-bad products, it works on hosts nobody has heard of.
# INITIALIZE_CLAUDE_AI_MCP__DISCOVERY__AUTH__CONTROL_PROBE=true
# INITIALIZE_CLAUDE_AI_MCP__DISCOVERY__AUTH__CONTROL_PATH_TEMPLATE=/initialize-claude-ai-control-{nonce}
#
# A package has to have something to do with the target. Without this, a
# keyword match registered @kubb/mcp -- a TypeScript code generator -- as the
# MCP server for Confluence, Bugzilla and build.opensuse.org. Two ways to be
# relevant: the package names the product, or it is a generic server
# configured for this host (which is what keeps mcp-graphql pointed at SMELT).
# INITIALIZE_CLAUDE_AI_MCP__PACKAGES__REQUIRE_RELEVANCE=true
# Host labels that name no product, removed before a target becomes a search
# term. The product is the leftmost meaningful label: confluence.example.com is
# searched for as "confluence", not "example". With ".de" missing from this list,
# smelt.example.net was searched for as the word "de".
# INITIALIZE_CLAUDE_AI_MCP__PACKAGES__GENERIC_HOST_LABELS=www,api,app,mcp,com,org,net,io,de,co,uk
# Trial a package even when its credential is unavailable. A stdio server reads
# its token when a tool is called, so it still handshakes and still lists every
# tool it has; refusing to start it let packages that need no credential win.
# Such a server is registered provisionally, slot empty, never as working.
# INITIALIZE_CLAUDE_AI_MCP__PACKAGES__TRIAL_WITHOUT_SECRETS=true
#
# Refuse to register an entry naming a path that is not there when it is
# written. .mcp.json is meant to be copied, and a path into this program's own
# scratch space -- a venv built to trial a package -- travels nowhere and may
# not survive even here. A launcher (npx -y, uvx, uv tool run) is preferred.
# INITIALIZE_CLAUDE_AI_MCP__REGISTRATION__REQUIRE_PATHS_EXIST=true
#
# --mcp-provision-missing, made permanent: auto | always | never (true/false
# mean always/never). When a local candidate needs a program that is not
# installed -- go, cargo, uvx, bunx -- install it from phase 1's catalog, once
# per run, then trial the candidate as usual. 'auto' only when no password
# prompt is involved; 'never' rejects the candidate as not installed, as before.
# It never changes which server is chosen, only whether it can be tried.
# INITIALIZE_CLAUDE_AI_MCP_PROVISION_MISSING=auto
#
# How many addresses are worked at the same time (--concurrency N). 1 is
# strictly one after another and starts no thread at all. Phase 4 is ~98%
# agent thinking and addresses are independent, so this is the one thing that
# shortens a long run -- it reduces waiting, not work or tokens. Each server's
# output is held back and printed as one block, so nothing interleaves. The
# keyword "bare" means whatever bare --concurrency means (the next variable).
# INITIALIZE_CLAUDE_AI_MCP_CONCURRENCY=1
# How many addresses bare --concurrency (no number) works at the same time.
# INITIALIZE_CLAUDE_AI_MCP_CONCURRENCY_BARE=4
# How many times a failure that was about *this moment* -- a rate limit, a
# service unavailable -- is retried without spending one of the agent's
# attempts. Under --concurrency the rate limiting is partly self-inflicted, and
# without this the flag could buy a fallback the agent never earned.
# INITIALIZE_CLAUDE_AI_AGENT_TRANSIENT_RETRIES=3
#
# Not every product issues a "token". openQA issues an API key and a secret, and
# its MCP endpoint wants username:key:secret -- so it gets its own variable name
# and the briefing prints the shape and where to get one. The rule lives in
# [mcp.discovery.auth.profiles.openqa] in data/40-mcp.toml; add a table there for
# another product, or override one field from here, e.g.:
# INITIALIZE_CLAUDE_AI_MCP__DISCOVERY__AUTH__PROFILES__OPENQA__ENV=OPENQA_CREDENTIALS
#
# The variable a discovered openQA endpoint will ask you to export looks like:
# OPENQA_OPENSUSE_ORG_USERNAME_KEY_SECRET=yourlogin:0123456789ABCDEF:FEDCBA9876543210
#
# The variable is named after the shape of its value, so the name says what to
# set. "..._API_KEY" would read as "put the key here" -- which somebody did,
# and got a 403 with nothing to explain it. A single opaque token keeps the
# shorter "..._TOKEN". The shape comes from the agent at discovery time, so
# this works for products with no entry in [mcp.discovery.auth.profiles].
# An endpoint that answers 401/403 has proved it exists and speaks to
# authenticated clients.  It is written into .mcp.json with its credential slot
# left EMPTY -- "Authorization": "Bearer ${NAME}", never a value -- and reported
# as needing one, so supplying a token later is an export rather than a second
# discovery run.  Set to false to record such an endpoint in the report only.
# INITIALIZE_CLAUDE_AI_MCP__DISCOVERY__AUTH__REGISTER_AUTHENTICATED=true
# How that empty slot is named when neither the discovery nor the reference
# above named one.  {SLUG} is the server's own generated name, upper-cased:
# gitlab-example-net asks for GITLAB_EXAMPLE_NET_TOKEN.
# INITIALIZE_CLAUDE_AI_MCP__DISCOVERY__AUTH__TOKEN_ENV_TEMPLATE={SLUG}_TOKEN
# How many such endpoints to register per stage.  A host entirely behind a login
# answers 401 on every path probed; --exhaustive-mcp keeps all of them anyway.
# INITIALIZE_CLAUDE_AI_MCP__DISCOVERY__AUTH__MAX_PROVISIONAL=1
# DNS zones that are on your own network.  --mcp-server takes any address, and
# four things turn on whether the one you gave is local or public: whether the
# token above may travel over cleartext, whether cleartext costs the endpoint
# points in the ranking, whether the developer ports are probed, and whether a
# bare name defaults to https.  Loopback, RFC 1918, link-local, .local,
# .internal, .lan and .home.arpa are recognised already; name yours here if it
# is .corp, .intra, or a registered domain served split-horizon.  Additive, and
# nothing is inferred from your resolver -- being wrong in the public direction
# costs a withheld token, being wrong the other way puts one on someone's wire.
# INITIALIZE_CLAUDE_AI_MCP_LOCAL_SUFFIXES=.corp,.intra,acme-internal.net
# Extra names that mean this machine, beyond localhost and ::1.
# INITIALIZE_CLAUDE_AI_MCP_LOOPBACK_HOSTS=mcpbox.lan
# The target's own endpoint outranks everything, so the lower tiers (a published
# package, a bridge written here) refuse to run while one exists, and refuse to
# run before the four-step checklist that rules one out has been completed.
# Turning either off is how you get a custom script in front of a server that
# already speaks MCP, so both default to true.
# INITIALIZE_CLAUDE_AI_MCP__POLICY__REQUIRE_CHECKLIST=true
# INITIALIZE_CLAUDE_AI_MCP__POLICY__FORBID_LOWER_TIERS_WHEN_NATIVE=true
# Paths every run must probe before it may claim there is no native endpoint.
# INITIALIZE_CLAUDE_AI_MCP__POLICY__MANDATORY_PATHS=/mcp,/api/mcp,/v1/mcp,/sse
# Write the human-readable "_instructions" block into .mcp.json: what each
# server is, which variables it needs, and which entries look like duplicates.
# It holds names and commands only -- never a secret's value.
# INITIALIZE_CLAUDE_AI_MCP__INSTRUCTIONS__ENABLED=true
# INITIALIZE_CLAUDE_AI_MCP__INSTRUCTIONS__WARN_ON_DUPLICATES=true
# Step D of the checklist -- read what the target and the public registries say
# about MCP, rather than only what the probes found.
# INITIALIZE_CLAUDE_AI_MCP__DISCOVERY__WEB_GROUNDING__ENABLED=true
# A search endpoint for step D in traditional mode, where there is no model to
# search with. {query} is expanded into it. Empty by default and deliberately
# so: there is no default search provider, because sending an internal hostname
# to a third party is your decision, not this program's.
# INITIALIZE_CLAUDE_AI_MCP_SEARCH_URL=https://search.example.com/?q={query}
# Used to raise the GitHub rate limit while searching for server packages.
# INITIALIZE_CLAUDE_AI_GITHUB_TOKEN_REF=env:GITHUB_TOKEN
# How many names one target may be looked up under on PyPI. PyPI answers about
# one exact distribution name rather than a query, so the package stage renders
# mcp.packages.pypi_name_templates against the product name in the address and
# asks about each in turn; this caps what that costs. 0 removes the cap, and
# emptying mcp.packages.pypi_package_url turns the PyPI route off altogether.
# INITIALIZE_CLAUDE_AI_MCP_PYPI_LOOKUPS=6
# Seconds one official-MCP-registry request may take (mcp.packages.
# registry_timeout_seconds). The registry is measurably slower than npm, and a
# timeout there loses the one source that publishes launch commands and
# declared variables. A timeout is now reported in the stage findings.
# INITIALIZE_CLAUDE_AI_MCP_REGISTRY_TIMEOUT=30
# Model the phase-4 subagents run on. Empty means "whatever phase 3 provisioned".
# If the model named here is not enabled on your deployment, phase 4 now says so
# once and runs deterministically, instead of retrying the same 404 on every
# stage of every address -- which is what silently cost one run its .mcp.json.
# INITIALIZE_CLAUDE_AI_AGENT_MODEL=
# Which Claude Code the agent SDK runs (mcp.agent.sdk_cli): auto (the installed
# claude when it is at least as new as the copy the SDK ships), installed, or
# bundled. The SDK's own copy can be too old for the configured model: 2.1.259
# answered "does not support this model" while the installed 2.1.309 served it.
# INITIALIZE_CLAUDE_AI_SDK_CLI=auto
# Wall-clock ceiling for one agent stage, in seconds, enforced by both the SDK
# and the CLI runtime. A turn cap is not a time cap -- a single turn can spend
# ten minutes in a web search -- so without this a stage has no upper bound at
# all. When it fires, the next attempt is narrowed and given a smaller turn
# budget rather than being handed the same brief and the same quarter of an
# hour; only once the attempts are spent does the deterministic pipeline finish
# the stage, keeping whatever the agent found. 0 disables the ceiling.
# INITIALIZE_CLAUDE_AI_AGENT_TIMEOUT_SECONDS=900
# How often a running agent prints "still working". Raise it for a quieter
# report, set it to 0 to go back to silence between the delegation line and the
# verdict -- which is indistinguishable, on screen, from a hung process.
# INITIALIZE_CLAUDE_AI_AGENT_PROGRESS_SECONDS=30
# Also name every tool call the agent makes, not just that it is still alive.
# INITIALIZE_CLAUDE_AI_AGENT_VERBOSE=false
# How many times the agent may work the same stage before the deterministic
# pipeline is asked to finish it. Most first answers fail for a correctable
# reason, and each retry is handed exactly what went wrong with the last one, so
# a stage that gives up after one try is throwing away the agent's best
# property. 1 restores single-shot behaviour; raise it on a slow target.
# --agent-max-attempts N sets the same value for one run.
# INITIALIZE_CLAUDE_AI_AGENT_MAX_ATTEMPTS=3
# Stop spending those attempts once an endpoint has answered 401 or 403. Such an
# endpoint is the target's own MCP server proving it is there, and it is
# registered with its credential slot left empty; another attempt can only find
# the same URL and be refused by it again, at minutes a time. false goes on
# searching for an endpoint that needs no credential at all.
# INITIALIZE_CLAUDE_AI_AGENT_CREDENTIAL_WALL_SETTLES=true
# How much brief the FIRST attempt is given: full | plain | minimal.
#   full    -- the whole brief, with what earlier stages found pasted inline.
#   plain   -- shorter; those findings stay on disk for the agent to read.
#   minimal -- the target, what to establish, and the shape of the answer.
# A failure the model never got to read -- a request rejected before delivery,
# or one that ran past the clock -- moves the next attempt one step down this
# ladder on its own, because appending an explanation to a brief nobody read
# cannot help. Set this to "plain" where the full brief is always rejected, and
# stop paying for the attempt that rediscovers it every run.
# INITIALIZE_CLAUDE_AI_AGENT_PROMPT_REGISTER=full
# Models to try, in order, when a request is rejected before the model reads it.
# Empty by default: the configured model is the one to use, and naming another
# here would pin a model name into the program. Left empty, the rotation instead
# reads back the per-tier model ids phase 3 resolved against the live backend
# (mcp.agent.retry_model_tiers), so "try a different model" works without this.
# Comma-separated.
# INITIALIZE_CLAUDE_AI_AGENT_RETRY_MODELS=

# --------------------------------------------------------------------------- #
# Console -- how the phase banners and summary reports are drawn
# --------------------------------------------------------------------------- #
# auto | unicode | ascii. 'auto' falls back to ASCII on a stream that cannot
# encode a box-drawing character, which is any host still in the C locale.
# INITIALIZE_CLAUDE_AI_CONSOLE_GLYPHS=auto
# auto | vibrant | daylight | contrast | soft | basic. 'vibrant' is the default:
# four of six hues at the full chroma of the 256-colour cube, so the report is
# properly coloured rather than tinted grey, and all of them measured between 7:1
# and 11.7:1 against a dark terminal -- well past the 4.5:1 where text stops
# being readable, short of the neon corners that make people turn colour off.
# 'contrast' trades that chroma for an even weight (a tighter 7:1-10:1 band),
# 'daylight' is the design inverted for a light background, 'soft' is the quiet
# one, 'basic' the plain eight colours -- the scheme most terminal colour guides
# publish, and also spelled 'classic', 'standard' or 'ansi' here, since somebody
# who read it under one of those names should not have to find out what this
# program calls it. 'auto' picks 'vibrant', or 'daylight'
# when COLORFGBG says the background is light, wherever the terminal says it can
# render 256 colours. See them side by side with `initialize-claude-ai palette`.
# Colour is dropped entirely by --no-color, NO_COLOR or a non-tty -- and nothing
# is said in colour alone: every line also carries a word and a sign.
# INITIALIZE_CLAUDE_AI_CONSOLE_PALETTE=auto
# Total width of rules, banners and summary boxes, in columns.
# INITIALIZE_CLAUDE_AI_CONSOLE_WIDTH=80
# false drops every frame and prints the same content as plain lines.
# INITIALIZE_CLAUDE_AI_CONSOLE_DECORATE=true
# Print a [RUNNING] line before the few steps that can go quiet for a minute --
# a package install, a phase-4 stage, a subagent turn -- so the silence reads as
# work rather than as a hang. false leaves only the verdict lines.
# INITIALIZE_CLAUDE_AI_CONSOLE_PROGRESS=true
# Open the run with a block naming the command line, the options given, the
# settings this host rather than the package decides -- each with the file,
# variable or flag that decided it -- and the variables being read. Credentials
# are masked there as everywhere. --quiet keeps it out of the terminal but still
# writes it to the log; false drops the block from both, and even then the same
# facts stay under "invocation" in the --json report, so a report read months
# later can still say what the run was told.
# INITIALIZE_CLAUDE_AI_SHOW_INVOCATION=true
# Longest list printed per section of that block before it is elided with a
# count. A block nobody reads to the end is worth less than one that fits.
# INITIALIZE_CLAUDE_AI_SHOW_INVOCATION_ROWS=24

# Stop the run when a value it cannot do without is empty everywhere -- no flag,
# no config file, no variable here. The alternative is to guess, and a guessed
# project bills somebody else and then fails with a permission error naming a
# project nobody chose. Which values those are is per backend, in
# provision.required; this relaxes only the "at least one model resolved" rule.
# INITIALIZE_CLAUDE_AI_PROVISION__REQUIRE_MODEL=true
